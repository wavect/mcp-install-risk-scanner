{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavect/mcp-install-risk-scanner/blob/v0.1.0/schema/scan-report.schema.json",
  "title": "MCP Install Risk Scanner report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scannerVersion", "inputKind", "summary", "findings", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scannerVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "inputKind": { "type": "string", "minLength": 1 },
    "summary": {
      "enum": ["Stop and review", "Review recommended", "No known patterns flagged"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "severity", "category", "message", "redactedEvidence", "remediation", "references"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^MCP\\d{3}$" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "category": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "redactedEvidence": { "type": "string" },
          "remediation": { "type": "string", "minLength": 1 },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
