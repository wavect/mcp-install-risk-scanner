  "type": "module",
  "license": "GPL-3.0-only",
  "homepage": "https://wavect.io/tools/mcp-install-risk-scanner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavect/mcp-install-risk-scanner.git"
